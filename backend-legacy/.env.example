# Worth2Watch v1 backend — copy to .env and fill in.
# The defaults below match docker-compose.yml so `docker compose up`
# brings the whole thing up without further tweaking.

PORT=3000

# Mongo connection string. The hostname `mongo` resolves inside the
# docker-compose network. For a local-host MongoDB instead, use:
#   MONGO_URI=mongodb://localhost:27017/worth2watch
MONGO_URI=mongodb://mongo:27017/worth2watch

# JWT signing secret. CHANGE THIS in any real deployment.
SECRET_TOKEN=change-me-to-a-long-random-string-before-deploying

# Where the v2 frontend lives (used for CORS).
FRONTEND_ORIGIN=http://localhost:5173
