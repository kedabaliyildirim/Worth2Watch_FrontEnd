# Worth2Watch backend — copy to .env and edit if needed.
# Defaults match docker-compose, so `docker compose up` brings the
# whole thing up unmodified.

DJANGO_SECRET_KEY=dev-only-please-change-this-in-production-aaaaaaaaaa
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated CORS allow-list. Vite default + Vite alt port.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Set DATABASE_URL to use Postgres (docker-compose does this for you);
# leave it unset to use the bundled SQLite file (zero setup, dev only).
# DATABASE_URL=postgres://worth2watch:worth2watch@db:5432/worth2watch
